{
    "name": "tomatophp/filament-discord",
    "type": "library",
    "description": "Send Notification to discord channel Webhook using native FilamentPHP Notification Facade class",
    "keywords": [
        "php",
        "laravel",
        "filamentphp",
        "filament-plugin",
        "notificaiton",
        "discord",
        "notification-driver",
        "tomatophp"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TomatoPHP\\FilamentDiscord\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TomatoPHP\\FilamentDiscord\\Tests\\": "tests/src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TomatoPHP\\FilamentDiscord\\FilamentDiscordServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Fady Mondy",
            "email": "info@3x1.io"
        }
    ],
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse src --level=0",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "require": {
        "php": "^8.2",
        "tomatophp/console-helpers": "^1.1",
        "filament/filament": "^5.0",
        "filament/notifications": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "pestphp/pest-plugin-livewire": "^4.0|^5.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "version": "5.0.0"
}
